# Normaliza quebras de linha entre Windows e Linux/macOS
* text=auto

*.java       text eol=lf
*.sql        text eol=lf
*.sh         text eol=lf
*.md         text eol=lf
*.properties text eol=lf
*.html       text eol=lf
*.css        text eol=lf
*.js         text eol=lf
*.json       text eol=lf

*.bat        text eol=crlf
*.ps1        text eol=crlf

*.jar        binary
*.zip        binary
*.png        binary
*.jpg        binary
*.pdf        binary
